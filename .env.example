# Local MySQL settings (Docker Compose defaults are development only)
DB_USERNAME=lercs
DB_PASSWORD=replace-with-a-unique-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password
DB_URL=jdbc:mysql://localhost:3306/emergency_resource_coordination?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_DRIVER=com.mysql.cj.jdbc.Driver
JWT_SECRET=replace-with-a-random-secret-at-least-64-characters-long
JWT_EXPIRATION_MS=3600000
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5MB
LERCS_SEED_PASSWORD=
